# Catalogue Service - Environment Variables Example

# HTTP Server & Graceful Shutdown
CATALOGUE_SERVER_PORT=8081
CATALOGUE_SHUTDOWN_TIMEOUT=30s

# PostgreSQL Datasource & HikariCP Connection Pool
CATALOGUE_DB_URL=jdbc:postgresql://localhost:5432/catalogue
CATALOGUE_DB_USERNAME=catalogue
CATALOGUE_DB_PASSWORD=catalogue
CATALOGUE_DB_MAX_POOL_SIZE=10
CATALOGUE_DB_CONN_TIMEOUT_MS=5000

# Flyway Migrations
CATALOGUE_FLYWAY_ENABLED=true

# Inventory & Orders Internal Provisioning Client
INVENTORY_ORDERS_BASE_URL=http://localhost:8082
INVENTORY_ORDERS_CONNECT_TIMEOUT_MS=2000
INVENTORY_ORDERS_READ_TIMEOUT_MS=5000

# Session Provisioning Outbox Worker / Scheduler
CATALOGUE_PROVISIONING_POLL_MS=1000
CATALOGUE_PROVISIONING_MAX_ATTEMPTS=5
CATALOGUE_PROVISIONING_LEASE_MS=30000
CATALOGUE_PROVISIONING_MAX_BACKOFF_MS=60000

# Idempotency key retention
CATALOGUE_IDEMPOTENCY_RETENTION=PT24H
CATALOGUE_IDEMPOTENCY_PURGE_MS=3600000
